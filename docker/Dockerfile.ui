FROM node:22-alpine AS builder
WORKDIR /app
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ .
RUN npx vite build

# Non-root: listen on 8080 (unprivileged). Chart/Service port mapping is a helm follow-up.
FROM nginx:1.27-alpine
COPY docker/nginx-ui.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /usr/share/nginx/html \
	&& touch /var/run/nginx.pid \
	&& chown -R nginx:nginx /var/cache/nginx /var/log/nginx /var/run/nginx.pid /etc/nginx/conf.d
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
